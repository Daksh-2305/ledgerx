# ==============================================================================
# LedgerX Configuration Reference (.env.example)
# Production-Hardened Financial Infrastructure Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Process Settings
# ------------------------------------------------------------------------------
# Mode: development | test | production
# In production, strict security validations fail-fast on default secrets.
NODE_ENV=development

PORT=3000
HOST=0.0.0.0
SERVICE_NAME=ledgerx-core

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Request body size limit (e.g. 1mb, 2mb)
BODY_LIMIT=1mb

# Graceful shutdown timeout in milliseconds before forcing process termination
SHUTDOWN_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (Authoritative Financial Source of Truth)
# ------------------------------------------------------------------------------
# Must use an ACID-compliant PostgreSQL 14+ instance with pg_trgm & pgcrypto
DATABASE_URL=postgresql://ledgerx_user:ledgerx_secret@localhost:5432/ledgerx_db?schema=public

# Connection pool sizing
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. Redis Infrastructure (Locks, Rate Limiting, Temporary Caches)
# ------------------------------------------------------------------------------
# NOTE: PostgreSQL remains the financial authority. If Redis is unavailable,
# the platform degrades safely to in-memory fallbacks or direct DB lookups.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_REQUESTS=100

CACHE_TTL_PAYMENT_SECS=300
CACHE_TTL_ACCOUNT_SECS=60
DISTRIBUTED_LOCK_TTL_MS=5000

# ------------------------------------------------------------------------------
# 4. Apache Kafka & Transactional Outbox (Milestone 6)
# ------------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ledgerx
KAFKA_GROUP_ID=ledgerx-consumer-group
KAFKA_CONNECT_TIMEOUT_MS=5000

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5

# ------------------------------------------------------------------------------
# 5. Webhooks & Dead Letter Queue (Milestone 7)
# ------------------------------------------------------------------------------
# In production, WEBHOOK_SECRET must be set to a secure, randomly-generated >= 32 char key.
WEBHOOK_SECRET=whsec_mockpay_development_secret_32chars
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_DELAY_MS=1000
WEBHOOK_DLQ_TOPIC=ledgerx.webhook.dlq
WEBHOOK_CONSUMER_GROUP=ledgerx-webhook-processor

# ------------------------------------------------------------------------------
# 6. Administrative Authorization & Operational Control
# ------------------------------------------------------------------------------
# Privileged administrative key required for DLQ replays, manual reconciliation resolution,
# and settlement execution. Must be changed in production.
ADMIN_API_KEY=ledgerx_admin_secret_key_change_in_production

# ------------------------------------------------------------------------------
# 7. Transaction Risk Engine (Milestone 8)
# ------------------------------------------------------------------------------
RISK_CONSUMER_GROUP=ledgerx-risk-engine
RISK_HIGH_PAYMENT_THRESHOLD_MINOR=500000
RISK_PAYMENT_VELOCITY_MAX_COUNT=10
RISK_PAYMENT_VELOCITY_WINDOW_SECS=60
RISK_FAILURE_VELOCITY_MAX_COUNT=5
RISK_FAILURE_VELOCITY_WINDOW_SECS=300
RISK_BURST_MAX_COUNT=3
RISK_BURST_WINDOW_SECS=10
RISK_REFUND_VELOCITY_MAX_COUNT=3
RISK_REFUND_VELOCITY_WINDOW_SECS=600

# ------------------------------------------------------------------------------
# 8. Automated Financial Reconciliation (Milestone 9)
# ------------------------------------------------------------------------------
RECONCILIATION_CONSUMER_GROUP=ledgerx-reconciliation
RECONCILIATION_DEFAULT_PROVIDER=mockpay
RECONCILIATION_BATCH_SIZE=500

# ------------------------------------------------------------------------------
# 9. Settlement & Settlement Batches (Milestone 10)
# ------------------------------------------------------------------------------
SETTLEMENT_CONSUMER_GROUP=ledgerx-settlement
SETTLEMENT_DEFAULT_FEE_BPS=200
SETTLEMENT_REQUIRE_RECONCILIATION=true

# ------------------------------------------------------------------------------
# 10. Security & CORS (Milestone 12)
# ------------------------------------------------------------------------------
# In production, set CORS_ORIGIN to specific frontend domains (e.g., https://dashboard.ledgerx.com).
CORS_ORIGIN=*
JWT_SECRET=development_jwt_secret_change_in_production_min32chars

# ------------------------------------------------------------------------------
# 11. Observability (Prometheus & Distributed Tracing)
# ------------------------------------------------------------------------------
METRICS_ENABLED=true
TRACING_ENABLED=true
